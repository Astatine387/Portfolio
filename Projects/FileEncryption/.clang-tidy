---
# cert-err33-c lives here rather than in the repository root because this is the project whose output is published by a
# rename: a write error the file system held back has to be noticed before that rename runs. The root config is shared
# with PasswordManager, which is not part of that guarantee and would only inherit the suppressions.

InheritParentConfig: true

Checks: >
  cert-err33-c

WarningsAsErrors: >
  cert-err33-c
